# ---------------------------------------------------------------------------
# AI Livestock Guardian — backend environment template
# Copy to .env and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

APP_NAME="AI Livestock Guardian"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL in production (Neon/Render). SQLite is used when unset for local demos.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/livestock_guardian?sslmode=require

# Authentication — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Optional LLM adapter. Without a key the system uses deterministic expert rules.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_PROVIDER=gemini

# Cache / background jobs (optional)
REDIS_URL=redis://localhost:6379/0
ENABLE_BACKGROUND_TASKS=false

# Storage — local uploads by default; S3-compatible settings are read by deployment adapters.
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8000
MAX_UPLOAD_MB=8

# Comma separated origins for the web and Expo dev clients
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://localhost:19006

RATE_LIMIT_PER_MINUTE=240

# Demonstration dataset (Ramesh scenario). Disable for a clean production database.
SEED_DEMO_DATA=true
DEMO_PASSWORD=Demo@1234
